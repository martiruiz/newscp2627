generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  name                 String?
  password             String
  role                 String      @default("ROLE_ADMIN")
  plan                 String      @default("free")
  superAdmin           Boolean     @default(false)
  stripeCustomerId     String?     @unique
  stripeSubscriptionId String?     @unique
  planExpiresAt        DateTime?
  savedPosts           SavedPost[]
  // Onboarding
  onboardingCompleted    Boolean   @default(false)
  onboardingCompletedAt  DateTime?
  userType               String?
  userSports             String?
  userCompetitions       String?
  ownAccounts            String?
  competitors            String?
  goals                  String?
  resources              String?
  market                 String?
  preferredLanguage      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Platform {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications Publication[]
  createdAt    DateTime      @default(now())
}

model Sport {
  id           String               @id @default(uuid())
  name         String               @unique
  slug         String               @unique
  publications PublicationSport[]
  createdAt    DateTime             @default(now())
}

model Competition {
  id           String                      @id @default(uuid())
  name         String                      @unique
  slug         String                      @unique
  publications PublicationCompetition[]
  createdAt    DateTime                    @default(now())
}

model EntityType {
  id           String                  @id @default(uuid())
  name         String                  @unique
  slug         String                  @unique
  publications PublicationEntityType[]
  createdAt    DateTime                @default(now())
}

model ContentFormat {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications Publication[]
  createdAt    DateTime      @default(now())
}

model Classification {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications PublicationClassification[]
  createdAt    DateTime      @default(now())
}

model ContentCategory {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications PublicationContentCategory[]
  createdAt    DateTime      @default(now())
}

model Publication {
  id                String   @id @default(uuid())
  platformId        String
  platform          Platform @relation(fields: [platformId], references: [id])
  externalPostId    String
  originalUrl       String?
  canonicalUrl      String
  embedUrl          String
  instagramPostType String?
  accountUsername   String?
  rawTitle          String?
  publishedAt       DateTime?
  contentFormatId   String?
  contentFormat     ContentFormat? @relation(fields: [contentFormatId], references: [id])
  entityName        String?
  sports            PublicationSport[]
  entityTypes       PublicationEntityType[]
  competitions      PublicationCompetition[]
  classifications   PublicationClassification[]
  contentCategories PublicationContentCategory[]
  savedBy           SavedPost[]
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id])
  rawImportData     String?
  importStatus      String?
  importError       String?
  reviewStatus      String?   // null=legacy | "pending" | "approved" | "rejected"
  reviewedAt        DateTime?
  reviewedBy        String?
  archivedAt        DateTime? // set = archived, null = active
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([platformId, externalPostId])
  @@index([platformId])
  @@index([contentFormatId])
  @@index([publishedAt(sort: Desc)])
  @@index([entityName])
  @@index([accountUsername])
  @@index([platformId, publishedAt(sort: Desc)])
  @@index([contentFormatId, publishedAt(sort: Desc)])
  @@index([reviewStatus])
  @@index([createdAt(sort: Desc)])
}

model PublicationCompetition {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([publicationId, competitionId])
  @@index([competitionId])
  @@index([publicationId])
}

model PublicationSport {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sportId       String
  sport         Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([publicationId, sportId])
  @@index([sportId])
  @@index([publicationId])
}

model PublicationEntityType {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  entityTypeId  String
  entityType    EntityType  @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)

  @@unique([publicationId, entityTypeId])
  @@index([entityTypeId])
  @@index([publicationId])
}

model PublicationClassification {
  id               String         @id @default(uuid())
  publicationId    String
  publication      Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  classificationId String
  classification   Classification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, classificationId])
}

model PublicationContentCategory {
  id                String          @id @default(uuid())
  publicationId     String
  publication       Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  contentCategoryId String
  contentCategory   ContentCategory @relation(fields: [contentCategoryId], references: [id], onDelete: Cascade)

  @@unique([publicationId, contentCategoryId])
}

model SavedPost {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        SavedFolder? @relation(fields: [folderId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([userId, publicationId, folderId])
}

model SavedFolder {
  id        String      @id @default(uuid())
  name      String
  userId    String
  posts     SavedPost[]
  createdAt DateTime    @default(now())

  @@unique([userId, name])
}

model NewsArticle {
  id          String    @id @default(uuid())
  url         String    @unique
  title       String
  excerpt     String?
  imageUrl    String?
  platform    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  category    String?
  publishedAt DateTime?
  content     String
  imageUrl    String?
  imageAlt    String?
  keywords    String?
  embed1      String?
  embed2      String?
  embed3      String?
  embed4      String?
  embed5      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("content")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model JobPosting {
  id            String    @id @default(uuid())
  title         String
  company       String
  companyHandle String?
  companyLogo   String?
  description   String
  jobType       String    @default("FULL-TIME")
  workMode      String?
  location      String?
  salary        String?
  sourceUrl     String
  applyUrl      String?
  featured      Boolean   @default(false)
  active        Boolean   @default(true)
  postedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CalendarItem {
  id              String   @id @default(uuid())
  userId          String
  sourceContentId String?
  sourceType      String   @default("scp")
  title           String
  plannedDate     String
  plannedTime     String?
  status          String   @default("planned")
  platforms       String   @default("[]")
  notes           String?
  referenceUrl    String?
  thumbnailUrl    String?
  creatorName     String?
  sport           String?
  contentFormat   String?
  collaborators   String   @default("[]")
  hook            String?
  script          String?
  cta             String?
  // Plan Builder extensions (all nullable for backward compat)
  planId                         String?
  phaseId                        String?
  priority                       String?  // required | recommended | optional
  contentPillar                  String?
  campaign                       String?
  objective                      String?
  targetAudience                 String?
  assigneeId                     String?
  productionDeadline             String?
  approvalStatus                 String?  // draft | pending_approval | changes_requested | approved
  approverId                     String?
  shortConcept                   String?
  whyThisIdea                    String?
  caption                        String?
  shotList                       String?
  requiredAssets                 String?
  sourceSnapshot                 String?  // JSON snapshot of source publication
  relativeTimeRule               String?  // e.g. "T-90m" | "event_end+30m"
  relativeTimeManuallyOverridden Boolean  @default(false)
  publishedUrl                   String?
  hubPhase                       String?  // D-2 | D-1 | D0 | H-3 | H0 | H+1 | D+1
  publishedBy                    String?  // home | away | both | competition
  visibility                     String?  // shared | home_only | away_only | schedule_only
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan  ContentPlan?      @relation(fields: [planId], references: [id])
  phase ContentPlanPhase? @relation(fields: [phaseId], references: [id])

  @@index([userId])
  @@index([userId, plannedDate])
  @@index([planId])
  @@index([phaseId])
}

model ContentPlan {
  id             String   @id @default(uuid())
  userId         String
  name           String
  type           String   @default("custom")
  sport          String?
  startDate      String
  endDate        String
  timezone       String   @default("Europe/Madrid")
  eventStartAt   String?
  eventEndAt     String?
  team           String?
  opponent       String?
  competition    String?
  venue          String?
  homeAway       String?
  mainObjective       String?
  secondaryObjective  String?
  targetAudience      String?
  platforms           String   @default("[]")
  contentPillars      String   @default("[]")
  teamMembers         String   @default("[]")
  sponsors            String   @default("[]")
  kpis                String   @default("[]")
  clientName          String?
  coverageIntensity   String?
  colorScheme         String?
  parentPlanId        String?
  ownerId             String?
  approverId          String?
  status              String   @default("draft")
  currentVersion      Int      @default(1)
  notes               String?
  archivedAt          String?
  fixtureId            String?
  fixture              Fixture? @relation(fields: [fixtureId], references: [id])
  collaborationEnabled Boolean @default(false)
  guestOrgName         String?
  guestOrgEmail        String?
  inviteToken          String?
  hubStatus            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  phases      ContentPlanPhase[]
  items       CalendarItem[]
  versions    PlanVersion[]
  reviewLinks ReviewLink[]
  comments    PlanComment[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, startDate])
}

model ContentPlanPhase {
  id                 String   @id @default(uuid())
  planId             String
  plan               ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  phaseKey           String?
  label              String
  description        String?
  sortOrder          Int      @default(0)
  anchorType         String   @default("absolute")
  startOffsetMinutes Int?
  endOffsetMinutes   Int?
  startsAt           String?
  endsAt             String?
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items CalendarItem[]

  @@index([planId])
}

model PlanVersion {
  id            String      @id @default(uuid())
  planId        String
  plan          ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      String
  submittedBy   String?
  summary       String?
  approvalState String?
  createdAt     DateTime    @default(now())

  @@index([planId])
}

model PlanComment {
  id          String      @id @default(uuid())
  planId      String
  plan        ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId      String?
  authorName  String
  authorEmail String?
  content     String
  isInternal  Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([planId])
  @@index([itemId])
}

model ApprovalAction {
  id           String   @id @default(uuid())
  planId       String?
  itemId       String?
  reviewLinkId String?
  action       String
  actorName    String
  actorEmail   String?
  comment      String?
  version      Int?
  createdAt    DateTime @default(now())

  @@index([planId])
  @@index([itemId])
}

model ReviewLink {
  id          String      @id @default(uuid())
  planId      String
  plan        ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tokenHash   String      @unique
  permissions String      @default("view")
  expiresAt   String?
  revokedAt   String?
  label       String?
  createdBy   String?
  createdAt   DateTime    @default(now())

  @@index([planId])
}

model PlanTemplate {
  id             String   @id @default(uuid())
  userId         String?
  name           String
  type           String
  sport          String?
  description    String?
  platforms      String   @default("[]")
  contentPillars String   @default("[]")
  isSystem       Boolean  @default(false)
  archivedAt     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  phases PlanTemplatePhase[]

  @@index([userId])
}

model PlanTemplatePhase {
  id                 String       @id @default(uuid())
  templateId         String
  template           PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  phaseKey           String?
  label              String
  description        String?
  sortOrder          Int          @default(0)
  anchorType         String       @default("absolute")
  startOffsetMinutes Int?
  endOffsetMinutes   Int?

  items PlanTemplateItem[]

  @@index([templateId])
}

model PlanTemplateItem {
  id               String            @id @default(uuid())
  phaseId          String
  phase            PlanTemplatePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title            String
  platforms        String            @default("[]")
  contentPillar    String?
  objective        String?
  priority         String            @default("recommended")
  relativeTimeRule String?
  shortConcept     String?
  hook             String?
  script           String?
  cta              String?

  @@index([phaseId])
}

model Fixture {
  id          String   @id @default(uuid())
  userId      String
  sport       String?
  homeTeam    String
  awayTeam    String
  homeCrest   String?
  awayCrest   String?
  competition String?
  matchday    String?
  venue       String?
  kickoffAt   String?
  timezone    String   @default("Europe/Madrid")
  durationMin Int?
  status      String   @default("scheduled")
  homeScore   Int?
  awayScore   Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans ContentPlan[]

  @@index([userId])
  @@index([kickoffAt])
}

model ContentReference {
  id             String   @id @default(uuid())
  calendarItemId String
  publicationId  String
  adaptationNote String?
  createdAt      DateTime @default(now())

  @@index([calendarItemId])
  @@index([publicationId])
}

model ContentVariant {
  id             String   @id @default(uuid())
  calendarItemId String
  platform       String
  format         String?
  copy           String?
  hashtags       String?
  durationSec    Int?
  dimensions     String?
  plannedAt      String?
  status         String   @default("planned")
  publishedUrl   String?
  metrics        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([calendarItemId])
}

model ImportBatch {
  id             String        @id @default(uuid())
  filename       String
  totalRows      Int
  validRows      Int           @default(0)
  importedRows   Int           @default(0)
  updatedRows    Int           @default(0)
  skippedRows    Int           @default(0)
  invalidRows    Int           @default(0)
  failedRows     Int           @default(0)
  status         String        @default("pending")
  errorLog       String?
  processingTime Int?
  publications   Publication[]
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
}
