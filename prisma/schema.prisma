generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String?
  password  String
  role      String      @default("ROLE_ADMIN")
  plan      String      @default("free")
  savedPosts SavedPost[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Platform {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications Publication[]
  createdAt    DateTime      @default(now())
}

model Sport {
  id           String               @id @default(uuid())
  name         String               @unique
  slug         String               @unique
  publications PublicationSport[]
  createdAt    DateTime             @default(now())
}

model Competition {
  id           String                      @id @default(uuid())
  name         String                      @unique
  slug         String                      @unique
  publications PublicationCompetition[]
  createdAt    DateTime                    @default(now())
}

model EntityType {
  id           String                  @id @default(uuid())
  name         String                  @unique
  slug         String                  @unique
  publications PublicationEntityType[]
  createdAt    DateTime                @default(now())
}

model ContentFormat {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications Publication[]
  createdAt    DateTime      @default(now())
}

model Classification {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications PublicationClassification[]
  createdAt    DateTime      @default(now())
}

model ContentCategory {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  publications PublicationContentCategory[]
  createdAt    DateTime      @default(now())
}

model Publication {
  id                String   @id @default(uuid())
  platformId        String
  platform          Platform @relation(fields: [platformId], references: [id])
  externalPostId    String
  originalUrl       String?
  canonicalUrl      String
  embedUrl          String
  instagramPostType String?
  accountUsername   String?
  rawTitle          String?
  publishedAt       DateTime?
  contentFormatId   String?
  contentFormat     ContentFormat? @relation(fields: [contentFormatId], references: [id])
  entityName        String?
  sports            PublicationSport[]
  entityTypes       PublicationEntityType[]
  competitions      PublicationCompetition[]
  classifications   PublicationClassification[]
  contentCategories PublicationContentCategory[]
  savedBy           SavedPost[]
  importBatchId     String?
  importBatch       ImportBatch? @relation(fields: [importBatchId], references: [id])
  rawImportData     String?
  importStatus      String?
  importError       String?
  reviewStatus      String?   // null=legacy | "pending" | "approved" | "rejected"
  reviewedAt        DateTime?
  reviewedBy        String?
  archivedAt        DateTime? // set = archived, null = active
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([platformId, externalPostId])
  @@index([platformId])
  @@index([contentFormatId])
  @@index([publishedAt(sort: Desc)])
  @@index([entityName])
  @@index([accountUsername])
  @@index([platformId, publishedAt(sort: Desc)])
  @@index([contentFormatId, publishedAt(sort: Desc)])
  @@index([reviewStatus])
  @@index([createdAt(sort: Desc)])
}

model PublicationCompetition {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([publicationId, competitionId])
  @@index([competitionId])
  @@index([publicationId])
}

model PublicationSport {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sportId       String
  sport         Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([publicationId, sportId])
  @@index([sportId])
  @@index([publicationId])
}

model PublicationEntityType {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  entityTypeId  String
  entityType    EntityType  @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)

  @@unique([publicationId, entityTypeId])
  @@index([entityTypeId])
  @@index([publicationId])
}

model PublicationClassification {
  id               String         @id @default(uuid())
  publicationId    String
  publication      Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  classificationId String
  classification   Classification @relation(fields: [classificationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, classificationId])
}

model PublicationContentCategory {
  id                String          @id @default(uuid())
  publicationId     String
  publication       Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  contentCategoryId String
  contentCategory   ContentCategory @relation(fields: [contentCategoryId], references: [id], onDelete: Cascade)

  @@unique([publicationId, contentCategoryId])
}

model SavedPost {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        SavedFolder? @relation(fields: [folderId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([userId, publicationId, folderId])
}

model SavedFolder {
  id        String      @id @default(uuid())
  name      String
  userId    String
  posts     SavedPost[]
  createdAt DateTime    @default(now())

  @@unique([userId, name])
}

model NewsArticle {
  id          String    @id @default(uuid())
  url         String    @unique
  title       String
  excerpt     String?
  imageUrl    String?
  platform    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  category    String?
  publishedAt DateTime?
  content     String
  imageUrl    String?
  imageAlt    String?
  keywords    String?
  embed1      String?
  embed2      String?
  embed3      String?
  embed4      String?
  embed5      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("content")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model ImportBatch {
  id             String        @id @default(uuid())
  filename       String
  totalRows      Int
  validRows      Int           @default(0)
  importedRows   Int           @default(0)
  updatedRows    Int           @default(0)
  skippedRows    Int           @default(0)
  invalidRows    Int           @default(0)
  failedRows     Int           @default(0)
  status         String        @default("pending")
  errorLog       String?
  processingTime Int?
  publications   Publication[]
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
}
